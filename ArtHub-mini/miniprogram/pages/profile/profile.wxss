.profile-page {
  background: var(--bg-page, #ffffff);
  min-height: 100vh;
}

/* 导航栏 */
.nav-header {
  display: flex;
  align-items: center;
  padding: 20rpx var(--large-plate);
  background: var(--bg-surface);
  border-bottom: var(--border-thin) solid var(--border-top-light);
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
}

/* 头像区域 – 卡片效果 */
.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: var(--large-module) var(--large-plate);
  padding: var(--title-content);
  background: var(--bg-surface);
  border-top: var(--border-thin) solid var(--border-top-light);
  border-left: var(--border-thin) solid var(--border-top-light);
  border-right: var(--border-thick) solid var(--border-bottom-dark);
  border-bottom: var(--border-thick) solid var(--border-bottom-dark);
  border-radius: 8rpx;
  position: relative;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--extra-light, #eee);
  border: var(--border-thin) solid var(--border-top-light);
}

.avatar-edit-icon {
  position: absolute;
  top: 50%;
  right: 50%;
  transform: translate(40rpx, 40rpx);
  background: var(--accent-green, #2e7d32);
  border-radius: 50%;
  padding: 10rpx;
  border: 2rpx solid #fff;
}

.avatar-tip {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 16rpx;
  font-weight: 500;
}

/* 表单卡片 */
.form-container {
  margin: 0 var(--large-plate) var(--large-module);
  background: var(--bg-surface);
  border-top: var(--border-thin) solid var(--border-top-light);
  border-left: var(--border-thin) solid var(--border-top-light);
  border-right: var(--border-thick) solid var(--border-bottom-dark);
  border-bottom: var(--border-thick) solid var(--border-bottom-dark);
  border-radius: 8rpx;
  overflow: hidden;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx var(--title-content);
  border-bottom: var(--border-thin) solid var(--border-top-light);
}
.form-item:last-child {
  border-bottom: none;
}

.form-label {
  width: 140rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.form-input {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-primary);
  padding: 8rpx 0;
}

.form-input[disabled] {
  color: var(--text-tertiary);
}

/* 保存按钮 */
.save-btn-container {
  padding: 30rpx var(--large-plate);
}

.save-btn {
  width: 100%;
  background: var(--bg-surface);
  color: var(--accent-green, #2e7d32);
  border-top: var(--border-thin) solid var(--border-top-light);
  border-left: var(--border-thin) solid var(--border-top-light);
  border-right: var(--border-thick) solid var(--border-bottom-dark);
  border-bottom: var(--border-thick) solid var(--border-bottom-dark);
  border-radius: 8rpx;
  font-size: 34rpx;
  font-weight: 700;
  padding: 24rpx;
  box-shadow: none;
  opacity: 0.5;  /* 默认半透明，可保存时恢复 */
}

.save-btn.active {
  background: var(--accent-green, #2e7d32);
  color: #ffffff;
  border-color: var(--accent-green);
  opacity: 1;
}

.save-btn:active {
  transform: scale(0.98);
}