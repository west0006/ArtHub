/* pages/profile/index.wxss - 夸克粗边框圆角风 + 绿色点缀 */

page {
  background-color: #ffffff;                /* 纯白背景 */
}

.page-container {
  background-color: #ffffff;
}

/* AI 助手固定条 - 粗黑边框，纯绿背景 */
.ai-assistant-fixed {
  position: fixed;
  bottom: 140rpx;
  left: 32rpx;
  right: 32rpx;
  display: flex;
  align-items: center;
  background: #2e7d32;                     /* 纯绿色替代渐变 */
  padding: 32rpx;                          /* 原尺寸保留 */
  border-top: var(--border-thin) solid var(--border-top-light);
border-left: var(--border-thin) solid var(--border-top-light);
border-right: var(--border-thick) solid var(--border-bottom-dark);
border-bottom: var(--border-thick) solid var(--border-bottom-dark);
border-radius: 8rpx;                   /* 统一圆角 */
  color: #ffffff;
  box-shadow: none;                        /* 去除阴影 */
  z-index: 998;
  box-sizing: border-box;
}

.ai-assistant-fixed .van-icon:first-child {
  margin-right: 24rpx;
  color: #ffffff;
}

.ai-assistant-fixed .van-icon:last-child {
  margin-left: auto;
  color: #ffffff;
}

.ai-content {
  flex: 1;
}

.ai-title {
  display: block;
  font-size: 30rpx;                        /* 原32rpx → 30rpx */
  font-weight: 700;
  margin-bottom: 8rpx;
  color: #ffffff;
}

.ai-desc {
  display: block;
  font-size: 22rpx;                        /* 原24rpx → 22rpx */
  opacity: 0.9;
  color: #ffffff;
}

/* 用户头部 - 纯绿背景，粗黑边框（底部） */
.user-header {
  display: flex;
  align-items: flex-start;
  padding: 60rpx 32rpx 40rpx;              /* 原尺寸保留 */
  background: #2e7d32;                     /* 纯绿色替代渐变 */
  color: #ffffff;
  position: relative;
  border-bottom: 6rpx solid #1a1a1a;       /* 粗黑底部边框 */
  box-sizing: border-box;
}

.user-avatar-section {
  position: relative;
  margin-right: 32rpx;                     /* 原尺寸保留 */
}

.user-avatar {
  width: 140rpx;                           /* 原尺寸保留 */
  height: 140rpx;
  border-top: var(--border-thin) solid var(--border-top-light);
border-left: var(--border-thin) solid var(--border-top-light);
border-right: var(--border-thick) solid var(--border-bottom-dark);
border-bottom: var(--border-thick) solid var(--border-bottom-dark);
border-radius: 8rpx;             /* 粗黑边框 */
  background-color: #ffffff;
  box-sizing: border-box;
}

.avatar-edit {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 48rpx;
  height: 48rpx;
  background-color: #1a1a1a;               /* 黑色编辑按钮 */
  border: 4rpx solid #ffffff;              /* 白边突出 */
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
}

.user-info {
  flex: 1;
}

.user-name-section {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.user-name {
  font-size: 38rpx;                        /* 原40rpx → 38rpx */
  font-weight: 700;
  margin-right: 20rpx;
  color: #ffffff;
}

.user-level {
  background-color: #1a1a1a;               /* 黑色背景 */
  padding: 8rpx 16rpx;
  border-radius: 4rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #ffffff;
  border: 2rpx solid #ffffff;              /* 内白边 */
}

.user-bio {
  font-size: 24rpx;                        /* 原26rpx → 24rpx */
  opacity: 0.9;
  margin-bottom: 32rpx;
  line-height: 1.4;
  color: #ffffff;
}

.user-stats {
  display: flex;
  gap: 40rpx;                              /* 原尺寸保留 */
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 30rpx;                        /* 原32rpx → 30rpx */
  font-weight: 700;
  margin: 8rpx;
  color: #ffffff;
}

.stat-label {
  font-size: 20rpx;                        /* 原22rpx → 20rpx */
  opacity: 0.8;
  color: #ffffff;
}

.settings-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #1a1a1a;               /* 黑色背景 */
  border: 4rpx solid #ffffff;
  border-radius: 6rpx;
  color: #ffffff;
}

/* 数据概览卡片 */
.overview-cards {
  display: flex;
  padding: 0 32rpx;
  margin-top: 40rpx;                       /* 原尺寸保留 */
  gap: 24rpx;
}

.overview-card {
  flex: 1;
  background-color: #ffffff;
  border-top: var(--border-thin) solid var(--border-top-light);
  border-left: var(--border-thin) solid var(--border-top-light);
  border-right: var(--border-thick) solid var(--border-bottom-dark);
  border-bottom: var(--border-thick) solid var(--border-bottom-dark);
  border-radius: 8rpx;
  padding: 32rpx 24rpx;                    /* 原尺寸保留 */
  display: flex;
  align-items: center;
  box-shadow: none;
  box-sizing: border-box;
}

.overview-card .van-icon {
  margin-right: 20rpx;
  color: #2e7d32;                          /* 图标用绿色 */
}

.card-content {
  display: flex;
  flex-direction: column;
}

.card-value {
  font-size: 30rpx;                        /* 原32rpx → 30rpx */
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.card-label {
  font-size: 20rpx;                        /* 原22rpx → 20rpx */
  color: #5a5a5a;
  font-weight: 500;
}

/* 功能网格 */
.function-grid {
  background-color: #ffffff;
  margin: 32rpx;                           /* 原尺寸保留 */
  border-top: var(--border-thin) solid var(--border-top-light);
border-left: var(--border-thin) solid var(--border-top-light);
border-right: var(--border-thick) solid var(--border-bottom-dark);
border-bottom: var(--border-thick) solid var(--border-bottom-dark);
border-radius: 8rpx;
  padding: 32rpx;                          /* 原尺寸保留 */
  box-sizing: border-box;
}

.grid-title {
  font-size: 30rpx;                        /* 原32rpx → 30rpx */
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 32rpx;
}

.grid-items {
  display: flex;
  flex-wrap: wrap;
  gap: 32rpx;                              /* 原尺寸保留 */
}

.grid-item {
  width: calc(33.333% - 22rpx);            /* 原尺寸保留 */
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 0;                        /* 原尺寸保留 */
  border-radius: 6rpx;
  background-color: #ffffff;
  border-top: var(--border-thin) solid var(--border-top-light);
  border-left: var(--border-thin) solid var(--border-top-light);
  border-right: var(--border-thick) solid var(--border-bottom-dark);
  border-bottom: var(--border-thick) solid var(--border-bottom-dark);
  border-radius: 4rpx;
  transition: none;
  box-sizing: border-box;
}

.grid-item:active {
  background-color: #f5f5f5;
  transform: scale(0.98);
}

.grid-item .van-icon {
  margin-bottom: 16rpx;
  color: #2e7d32;                          /* 绿色图标 */
}

.item-label {
  font-size: 22rpx;                        /* 原24rpx → 22rpx */
  color: #1a1a1a;
  margin-bottom: 12rpx;
  font-weight: 700;
}

.item-count,
.item-amount,
.item-status {
  font-size: 18rpx;                        /* 原20rpx → 18rpx */
  color: #5a5a5a;
  font-weight: 500;
}

/* 最近排单 */
.recent-orders {
  background-color: #ffffff;
  margin: 32rpx;
  border-top: var(--border-thin) solid var(--border-top-light);
border-left: var(--border-thin) solid var(--border-top-light);
border-right: var(--border-thick) solid var(--border-bottom-dark);
border-bottom: var(--border-thick) solid var(--border-bottom-dark);
border-radius: 8rpx;
  border-radius: 8rpx;
  padding: 32rpx;
  box-sizing: border-box;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 30rpx;                        /* 原32rpx → 30rpx */
  font-weight: 700;
  color: #1a1a1a;
}

.section-more {
  font-size: 24rpx;                        /* 原26rpx → 24rpx */
  color: #2e7d32;
  font-weight: 700;
}

.orders-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.order-item {
  padding: 24rpx;
  border-radius: 6rpx;
  background-color: #ffffff;
  border-top: var(--border-thin) solid var(--border-top-light);
border-left: var(--border-thin) solid var(--border-top-light);
border-right: var(--border-thick) solid var(--border-bottom-dark);
border-bottom: var(--border-thick) solid var(--border-bottom-dark);
border-radius: 4rpx;       /* 统一粗边框 */
  border-left-width: 8rpx;                 /* 左侧加粗保持强调 */
  border-left-color: #2e7d32;              /* 绿色强调 */
  box-sizing: border-box;
}

.order-item.urgent {
  border-left-color: #1a1a1a;              /* 紧急用黑色强调，不用红色 */
  background-color: #ffffff;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.order-title {
  font-size: 26rpx;                        /* 原28rpx → 26rpx */
  font-weight: 700;
  color: #1a1a1a;
  flex: 1;
}

.order-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 14rpx;
  border-radius: 4rpx;
  font-size: 18rpx;
  font-weight: 700;
  border: 2rpx solid #1a1a1a;
}

/* 状态颜色统一用黑白绿表达 */
.order-status.pending {
  background-color: #ffffff;
  color: #1a1a1a;
  border-color: #1a1a1a;
}

.order-status.progress {
  background-color: #2e7d32;
  color: #ffffff;
  border-color: #1a1a1a;
}

.order-status.completed {
  background-color: #1a1a1a;
  color: #ffffff;
  border-color: #1a1a1a;
}

.order-status.urgent {
  background-color: #1a1a1a;
  color: #ffffff;
  border-color: #1a1a1a;
}

.order-meta {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.order-client,
.order-deadline {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 20rpx;
  color: #5a5a5a;
  font-weight: 500;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-price {
  font-size: 24rpx;                        /* 原26rpx → 24rpx */
  font-weight: 700;
  color: #1a1a1a;                          /* 价格用黑色，不再红色 */
}

.order-progress {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.progress-bar {
  width: 120rpx;
  height: 8rpx;
  background-color: #e0e0e0;
  border: 2rpx solid #1a1a1a;
  border-radius: 2rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.progress-fill {
  height: 100%;
  background-color: #2e7d32;               /* 绿色进度 */
  border-radius: 0;
  transition: width 0.2s ease;
}

.progress-text {
  font-size: 18rpx;
  color: #5a5a5a;
  min-width: 40rpx;
  font-weight: 500;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-state .van-icon {
  margin-bottom: 24rpx;
  opacity: 0.5;
  color: #1a1a1a;
}

.empty-text {
  font-size: 26rpx;
  color: #1a1a1a;
  margin-bottom: 16rpx;
  font-weight: 700;
}

.empty-subtext {
  font-size: 20rpx;
  color: #5a5a5a;
}