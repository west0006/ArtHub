<!-- pages/search/search.wxml -->
<view class="page-container search-page">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input-container">
      <view class="search-input-wrapper">
        <van-icon name="search" size="32rpx" color="#999999" />
        <input 
          class="search-input" 
          placeholder="搜索素材、教程..." 
          value="{{searchValue}}"
          bindinput="onSearchInput"
          bindconfirm="onSearchConfirm"
          focus="{{autoFocus}}"
        />
        <van-icon 
          wx:if="{{searchValue}}" 
          name="clear" 
          size="32rpx" 
          color="#999999" 
          bindtap="onClearSearch" 
        />
      </view>
    </view>
  </view>

  <!-- 搜索历史 -->
  <view class="search-history" wx:if="{{!searchValue && !showResults}}">
    <view class="section-header">
      <text class="section-title">搜索历史</text>
      <view class="clear-history" bindtap="onClearHistory" wx:if="{{searchHistory.length > 0}}">
        <van-icon name="delete-o" size="28rpx" color="#999999" />
        <text>清空</text>
      </view>
    </view>
    <view class="history-tags">
      <view 
        class="history-tag" 
        wx:for="{{searchHistory}}" 
        wx:key="index" 
        bindtap="onHistoryTap" 
        data-keyword="{{item}}"
      >
        <van-icon name="clock-o" size="24rpx" color="#666666" />
        <text>{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 热门搜索 -->
  <view class="hot-search" wx:if="{{!searchValue && !showResults}}">
    <view class="section-header">
      <text class="section-title">热门搜索</text>
    </view>
    <view class="hot-tags">
      <view 
        class="hot-tag" 
        wx:for="{{hotSearch}}" 
        wx:key="keyword" 
        bindtap="onHotSearchTap" 
        data-keyword="{{item.keyword}}"
      >
        <text class="hot-index {{item.index <= 3 ? 'top-three' : ''}}">{{item.index}}</text>
        <text class="hot-keyword">{{item.keyword}}</text>
        <view class="hot-trend" wx:if="{{item.trend === 'up'}}">
          <van-icon name="arrow-up" size="20rpx" color="#E64340" />
        </view>
      </view>
    </view>
  </view>

  <!-- 搜索结果 -->
  <view class="search-results" wx:if="{{showResults}}">
    <!-- 搜索结果头部 -->
    <view class="results-header">
      <text class="results-title">
        搜索"{{searchValue}}"
        <text class="results-count">({{searchResults.length}}个结果)</text>
      </text>
      <view class="filter-tabs">
        <view 
          class="filter-tab {{currentFilter === 'all' ? 'active' : ''}}" 
          bindtap="onFilterChange" 
          data-filter="all"
        >
          全部
        </view>
        <view 
          class="filter-tab {{currentFilter === 'material' ? 'active' : ''}}" 
          bindtap="onFilterChange" 
          data-filter="material"
        >
          素材
        </view>
        <view 
          class="filter-tab {{currentFilter === 'tutorial' ? 'active' : ''}}" 
          bindtap="onFilterChange" 
          data-filter="tutorial"
        >
          教程
        </view>
      </view>
    </view>

    <!-- 搜索结果列表 -->
    <scroll-view class="results-scroll" scroll-y>
      <view class="results-list">
        <view 
          class="result-item" 
          wx:for="{{filteredResults}}" 
          wx:key="id" 
          bindtap="onResultTap" 
          data-item="{{item}}"
        >
          <view class="result-image">
            <view class="image-placeholder {{item.resourceType}}">
              <van-icon 
                name="{{item.resourceType === 'material' ? 'photo-o' : 'video-o'}}" 
                size="60rpx" 
                color="#ffffff" 
              />
            </view>
            <view class="result-badge" wx:if="{{item.isNew}}">NEW</view>
          </view>
          <view class="result-info">
            <text class="result-title">
              <text class="highlight-text">{{searchValue}}</text>
              <text>{{item.title.split(searchValue).join('')}}</text>
            </text>
            <view class="result-meta">
              <text class="result-author">{{item.author}}</text>
              <text class="result-type">{{item.type}}</text>
            </view>
            <view class="result-stats">
              <view class="stat-item">
                <van-icon name="eye-o" size="20rpx" color="#999999" />
                <text>{{item.views}}</text>
              </view>
              <view class="stat-item">
                <van-icon name="like-o" size="20rpx" color="#999999" />
                <text>{{item.likes}}</text>
              </view>
            </view>
          </view>
        </view>

        <!-- 空结果状态 -->
        <view class="empty-results" wx:if="{{filteredResults.length === 0}}">
          <van-icon name="search" size="120rpx" color="#cccccc" />
          <text class="empty-text">没有找到相关结果</text>
          <text class="empty-subtext">换个关键词试试吧</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 底部安全区域 -->
  <view class="bottom-safe-area"></view>
</view>