<!--pages/orderView/orderView.wxml-->
<view class="page-container">


	<!-- 状态标签栏 -->
	<view class="tabs-container">
		<view class="tabs">
			<view class="tab {{currentTab === 'all' ? 'active' : ''}}" bindtap="onTabChange" data-tab="all">
				<text>全部订单</text>
				<text class="tab-count">({{orderCounts.all}})</text>
			</view>
			<view class="tab {{currentTab === 'completed' ? 'active' : ''}}" bindtap="onTabChange" data-tab="completed">
				<text>已完成</text>
				<text class="tab-count">({{orderCounts.completed}})</text>
			</view>
			<view class="tab {{currentTab === 'progress' ? 'active' : ''}}" bindtap="onTabChange" data-tab="progress">
				<text>进行中</text>
				<text class="tab-count">({{orderCounts.progress}})</text>
			</view>
			<view class="tab {{currentTab === 'pending' ? 'active' : ''}}" bindtap="onTabChange" data-tab="pending">
				<text>待开始</text>
				<text class="tab-count">({{orderCounts.pending}})</text>
			</view>
		</view>
		<view class="tab-indicator" style="transform: translateX({{tabIndicatorPosition}}%)"></view>
	</view>

	<!-- 订单列表 -->
	<scroll-view class="orders-scroll" scroll-y>
		<view class="orders-list">
			<view class="order-item" wx:for="{{filteredOrders}}" wx:key="id" bindtap="onOrderTap" data-id="{{item.id}}">
				<view class="order-header">
					<text class="order-title">{{item.windowName || '未命名订单'}}</text>
					<view class="order-status {{item.status}}">
						<van-icon name="{{getStatusIcon(item.status)}}" size="20rpx" color="{{getStatusColor(item.status)}}" />
						<view wx:if="{{item.status=='pending'}}">待开始</view>
						<view wx:elif="{{item.status=='progress'}}">进行中</view>
						<view wx:elif="{{item.status=='completed'}}">已完成</view>
					</view>
				</view>

				<view class="order-meta">
					<view class="meta-row">
						<view class="meta-item">
							<van-icon name="user-o" size="24rpx" color="#666666" />
							<text class="meta-text">{{item.clientName || '未知客户'}}</text>
						</view>
						<view class="meta-item">
							<van-icon name="cash-o" size="24rpx" color="#666666" />
							<text class="meta-text">¥{{item.totalAmount || 0}}</text>
						</view>
					</view>
					<view class="meta-row">
						<view class="meta-item">
							<van-icon name="calendar-o" size="24rpx" color="#666666" />
							<text class="meta-text">{{item.startDate || '未设置'}}</text>
						</view>
						<view class="meta-item">
							<van-icon name="clock-o" size="24rpx" color="#666666" />
							<text class="meta-text">{{item.deadline || '未设置'}}</text>
						</view>
					</view>
				</view>

				<view class="order-actions">
					<view class="action-btn edit" bindtap="onEditOrder" data-id="{{item.id}}" catchtap>
						<van-icon name="edit" size="24rpx" color="#0A6E51" />
						<text>编辑</text>
					</view>
					<view class="action-btn status" bindtap="onChangeStatus" data-id="{{item.id}}" data-status="{{item.status}}" catchtap>
						<van-icon name="exchange" size="24rpx" color="#1989fa" />
						<text>改状态</text>
					</view>
					<view class="action-btn delete" bindtap="onDeleteOrder" data-id="{{item.id}}" catchtap>
						<van-icon name="delete" size="24rpx" color="#E64340" />
						<text>删除</text>
					</view>
				</view>
			</view>

			<!-- 空状态 -->
			<view class="empty-state" wx:if="{{filteredOrders.length === 0}}">
				<van-icon name="description" size="120rpx" color="#cccccc" />
				<text class="empty-text">
					{{currentTab === 'all' ? '暂无订单' : 
            currentTab === 'completed' ? '暂无已完成订单' :
            currentTab === 'progress' ? '暂无进行中订单' : '暂无待开始订单'}}
				</text>
				<text class="empty-subtext" wx:if="{{currentTab !== 'all'}}">试试查看其他状态的订单</text>
			</view>
		</view>
	</scroll-view>

	<!-- 创建订单按钮 -->
	<view class="create-order-btn" bindtap="onCreateOrder">
		<van-icon name="plus" size="48rpx" color="#ffffff" />
	</view>

	<!-- 底部安全区域 -->
	<view class="bottom-safe-area"></view>
</view>