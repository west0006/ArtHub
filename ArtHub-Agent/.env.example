# ArtHub-Agent 环境变量模板
# 复制本文件为 .env 并填入你的真实密钥，.env 已被 .gitignore 忽略，永不提交。

# 豆包（火山方舟/扣子）API
DOUBAO_API_KEY=your_doubao_api_key_here

# 腾讯云（用于 OCR / 视觉识别）
TENCENT_SECRET_ID=your_tencent_secret_id_here
TENCENT_SECRET_KEY=your_tencent_secret_key_here
TENCENT_REGION=ap-beijing

# 企业微信（备用方法，如需要）
# CORP_ID=
# AGENT_ID=
# CORP_SECRET=
# WX_CALLBACK_TOKEN=
# WX_ENCODING_AES_KEY=
